# AI ZAYA 2.0 - Server Configuration & AI Gateway Secrets
PORT=3000

# OpenRouter Configuration (NVIDIA Nemotron 3 Ultra)
OPENROUTER_API_KEY=your_openrouter_api_key_here
NEMOTRON_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_FALLBACK_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional Fallback Providers (leave blank if not using)
GROQ_API_KEY=
GEMINI_API_KEY=

# Security & Rate Limiting
RATE_LIMIT_DAILY=80
RATE_LIMIT_PER_MINUTE=15

